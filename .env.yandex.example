# OAuth-токен Яндекс.Диска (создай приложение на https://oauth.yandex.ru/client/new,
# scopes: yandex.disk; после consent screen обменяй code на токен).
YADISK_TOKEN=

# Папка назначения на Диске. Будет создана автоматически при первом заливе.
# Должна начинаться с /. Без завершающего слэша.
# Пример: /poker-assistant/test-builds
YADISK_FOLDER=/poker-assistant/test-builds
