{
  "name": "poker-assistant",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w @poker/core",
    "build:app": "npm run build -w app",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p apps/app/tsconfig.json",
    "dev": "npm run dev -w app",
    "dev:web": "npm run dev -w app",
    "build:android": "bash build-android.sh",
    "upload:android": "bash scripts/upload-yadisk.sh apps/app/app-debug.apk"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.18.0"
  }
}
