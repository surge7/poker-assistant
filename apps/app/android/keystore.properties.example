# Скопируйте этот файл в keystore.properties и укажите свои пароли (storePassword, keyPassword).
# keystore.properties не коммитить в git (уже в .gitignore).
#
# Важно: storeFile и путь — только латиница, без кириллицы. Сохраняйте файл в UTF-8.
# Путь к storeFile — относительно папки android/. Файл upload-keystore.jks должен лежать в android/.

storeFile=upload-keystore.jks
storePassword=ЗАПОЛНИТЕ_ПАРОЛЬ_ХРАНИЛИЩА
keyAlias=my-key-alias
keyPassword=ЗАПОЛНИТЕ_ПАРОЛЬ_КЛЮЧА
