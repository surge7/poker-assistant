{
  "name": "app",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:portable-web": "vite build --mode portable",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:android": "cap sync android && cap open android",
    "cap:ios": "cap sync ios && cap open ios",
    "android:prepare": "npm run build && npx cap add android && npx cap sync android",
    "android:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "./build-android-release.sh",
    "build:portable": "node scripts/build-portable.js",
    "build:single-html": "node scripts/build-single-html.js",
    "store-screenshots": "node scripts/prepare-store-screenshots.js",
    "generate-splash": "node scripts/generate-splash.js",
    "generate-icon": "node scripts/generate-icon.js",
    "slice-cards": "node scripts/slice-card-sprites.js",
    "fetch-cards": "node scripts/fetch-card-images.js",
    "generate-cards": "node scripts/generate-card-images.js",
    "process-logo": "node scripts/process-logo.js",
    "deploy:yandex": "./deploy-yandex.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/status-bar": "^6.0.3",
    "@poker/core": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@capacitor/android": "6.2.2",
    "@capacitor/cli": "6.2.2",
    "@capacitor/core": "6.2.2",
    "@playwright/test": "^1.59.1",
    "happy-dom": "^15.11.7",
    "sharp": "^0.33.0",
    "typescript": "^5.3.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "capacitor": {
    "webDir": "dist"
  },
  "license": "MIT"
}
