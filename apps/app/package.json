{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:android": "cap sync android && cap open android",
    "cap:ios": "cap sync ios && cap open ios",
    "android:prepare": "npm run build && npx cap add android && npx cap sync android",
    "android:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "./build-android-release.sh",
    "store-screenshots": "node scripts/prepare-store-screenshots.js",
    "generate-splash": "node scripts/generate-splash.js",
    "generate-icon": "node scripts/generate-icon.js",
    "deploy:yandex": "./deploy-yandex.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/status-bar": "^8.0.2",
    "@poker/core": "file:../../packages/core"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@playwright/test": "^1.59.1",
    "sharp": "^0.33.0",
    "typescript": "^5.3.0",
    "vite": "^6.0.0"
  },
  "capacitor": {
    "webDir": "dist"
  }
}
